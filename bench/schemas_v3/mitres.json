      "description": "name of a restaurant or chain",
      "examples": [
        "olive garden"
      ]
    },
    "cuisine": {
      "description": "a type of cuisine or restaurant category",
      "examples": [
        "thai",
        "fast food"
      ]
    },
    "dish": {
      "description": "a specific dish, food or drink",
      "examples": [
        "pad thai",
        "margaritas"
      ]
    },
    "amenity": {
      "description": "a feature or service of the place: seating, parking, bar, kid friendly, atmosphere",
