        "kid friendly"
      ]
    },
    "location": {
      "description": "where the restaurant should be, including relative phrases",
      "examples": [
        "near me",
        "within 5 miles",
        "downtown"
      ]
    },
    "hours": {
      "description": "opening time or time constraint",
      "examples": [
